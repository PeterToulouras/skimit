diff -ruN a/src/shop/reports/CsvExport.java b/src/shop/reports/CsvExport.java
--- a/src/shop/reports/CsvExport.java	1969-12-31 16:00:00.000000000 -0800
+++ b/src/shop/reports/CsvExport.java	2026-10-11 13:25:25.056483526 -0700
@@ -0,0 +1,12 @@
+package shop.reports;
+
+import java.util.List;
+import shop.model.Order;
+
+public class CsvExport {
+  public String export(List<Order> orders) {
+    StringBuilder sb = new StringBuilder("customer,quantity\n");
+    for (Order o : orders) sb.append(o.customer()).append(',').append(o.quantity()).append('\n');
+    return sb.toString();
+  }
+}
